# 本機開發範例；正式及隔離測試設定見 docs/migration/p1-portable-deploy.md。
NODE_ENV=development
PORT=3000
# 直接連線為 0；平台代理層數須依實際請求路徑核對。
TRUST_PROXY_HOPS=0
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=TainanSelect(STG)
DB_HOST=localhost
DB_PORT=3306

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 留空時維持既有僅允許白名單的登入行為。
ALLOWED_EMAIL_DOMAIN=
FRONTEND_BASE_URL=http://localhost:5173
# 必須包含 /api；Google 登記的後端 callback 為此值加 /auth/google/callback。
BACKEND_BASE_URL=http://localhost:3000/api
JWT_SECRET=

# 僅管理端 Google 搜尋同步需要；隔離測試預設不配置、不觸發同步。
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
